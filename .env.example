# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored, so your IDs are never committed.

# --- Required -------------------------------------------------------------

# Azure App Registration "Application (client) ID" (a public client; no
# secret is needed). See README.md -> Azure setup.
KINDLE_CLIENT_ID=YOUR-APP-CLIENT-ID

# The OneNote *section* ID where pages should be created (the "Quick Notes"
# section of your "Kindle Scribe" notebook). See README.md -> Finding your
# section ID.
KINDLE_SECTION_ID=PASTE-YOUR-SECTION-ID-HERE

# --- Optional (defaults shown) -------------------------------------------

# "consumers" for personal Microsoft accounts; a tenant ID/domain for work
# or school accounts.
#KINDLE_TENANT_ID=consumers

# Sender address Amazon uses for Kindle "send to" emails.
#KINDLE_SENDER=do-not-reply@amazon.com

# Mail folder that processed emails are moved into (created if missing).
#KINDLE_DEST_FOLDER=Kindle Scribe

# IANA timezone used for page titles and the expiry timestamp.
#KINDLE_TIMEZONE=America/New_York

# Amazon download links expire after this many days; shown on the page.
#KINDLE_EXPIRY_DAYS=7

# Maximum number of Kindle emails to process per run.
#KINDLE_MAX_PER_RUN=25

# HTTP timeout in seconds.
#KINDLE_HTTP_TIMEOUT=60

# Where to store the MSAL token cache (defaults to next to the script).
#KINDLE_TOKEN_CACHE=/path/to/token_cache.json
